# Backend API environment example

# Database connection (SQLAlchemy URL)
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT configuration
# IMPORTANT: Use a strong random string in production
JWT_SECRET=replace-with-strong-secret
# Access token expiry (minutes)
JWT_EXPIRES_MIN=60

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# App port
PORT=3001
