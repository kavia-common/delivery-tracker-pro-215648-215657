# Backend API environment configuration
# Copy this file to ".env" and adjust values for your environment.

# Database connection string used by SQLAlchemy.
# For local development, ensure your Postgres instance matches these credentials or update accordingly.
# Format examples:
#   postgresql://user:password@host:port/dbname
#   sqlite:///./app.db  (for SQLite file)
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# Secret for signing JWT tokens. Use a strong random string in production.
JWT_SECRET=change_me_in_production

# JWT expiration in minutes
JWT_EXPIRES_MIN=60

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Port for the FastAPI app (if used by your process manager)
PORT=3001
